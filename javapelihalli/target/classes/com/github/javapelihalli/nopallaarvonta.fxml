<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Button?>
<?import javafx.geometry.Insets?>

<VBox alignment="CENTER" spacing="20.0" xmlns="http://javafx.com/javafx/8.0.171" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.github.javapelihalli.NopallaArvontaController">
   <children>
      <Label text="Nopalla arvonta" />
        <Button fx:id="secondaryButton" text="Mene takaisin päävalikkoon" onAction="#switchToPrimary" />
        <Button fx:id="NoppaArvonta" text="Heitä noppia" onAction="#heitaNoppia" />
        <Label fx:id="noppa1" text="Noppa 1: " />
        <Label fx:id="noppa2" text="Noppa 2: " />
        <Label fx:id="noppa3" text="Noppa 3: " />
   </children>
   <padding>
      <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
   </padding>
</VBox>